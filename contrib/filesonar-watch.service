# systemd user unit that keeps the filesonar index up to date.
# Install:  cp filesonar-watch.service ~/.config/systemd/user/
#           systemctl --user daemon-reload && systemctl --user enable --now filesonar-watch
[Unit]
Description=filesonar: keep the file content index up to date
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/filesonar watch
Restart=on-failure
RestartSec=30
# Indexing is background work: stay out of the way of interactive programs.
Nice=10
IOSchedulingClass=idle

# Hardening that works in user services (system-level options such as
# ProtectSystem need capabilities a user's systemd instance does not have).
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
